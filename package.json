{
  "name": "kurshamster",
  "productName": "KursHamster",
  "version": "0.4.0",
  "description": "Hamstert alle deine Daten aus Stud.IP: Kursdateien und Nachrichten, gesichert auf dem eigenen Rechner.",
  "homepage": "https://github.com/john-bruene/kurshamster",
  "repository": {
    "type": "git",
    "url": "https://github.com/john-bruene/kurshamster.git"
  },
  "main": "src/main/main.js",
  "author": "John Frederic Brüne",
  "license": "MIT",
  "private": true,
  "kurshamster": {
    "updateRepo": "john-bruene/kurshamster"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "test:e2e": "electron test/e2e.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "readme:map": "node tools/readme-map.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.kurshamster",
    "productName": "KursHamster",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "KursHamster-${version}-Mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KursHamster-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "john-bruene",
        "repo": "kurshamster",
        "releaseType": "release"
      }
    ]
  }
}
